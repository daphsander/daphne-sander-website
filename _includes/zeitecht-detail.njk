---
layout: base.njk
currentSection: "/zeitecht/"
---
{% macro pricingText(text) -%}
  {{ text | escape | replace('[[mobile-break]]', '<br class="pricing-break-mobile">') | replace('[[desktop-break]]', '<br class="pricing-break-desktop">') | safe }}
{%- endmacro %}

<div class="detail-hero">
  {% if desktop_image or mobile_image %}
    <picture class="image">
      {% if mobile_image %}
        <source media="(max-width: 640px)" srcset="{{ mobile_image }}">
      {% endif %}
      <img src="{{ desktop_image or mobile_image }}" alt="{{ title }}" style="width:100%;height:100%;object-fit:cover;">
    </picture>
  {% else %}
    <div class="ph image">Bild</div>
  {% endif %}
  <div>
    <h1>{{ title }}</h1>
    {% if detail_meta %}<div class="meta">{{ detail_meta }}</div>{% endif %}
    {% if tagline %}<div class="tagline">{{ tagline }}</div>{% endif %}
    <div class="desc">{{ content | safe }}</div>
  </div>
</div>

<div class="info-strip">
  {% if auszug_text %}
  <div class="item">
    <div class="link" data-lightbox="lightbox-auszug">Auszüge lesen</div>
    <div class="caption">öffnet eine Vorschau</div>
  </div>
  {% endif %}
  {% if schluessel_image %}
  <div class="item with-key">
    {% if schluessel_pdf %}
    <a class="key-image clickable" href="{{ schluessel_pdf }}" target="_blank" rel="noopener" data-mobile-download>
      <img src="{{ schluessel_image }}" alt="Inszenierungsschlüssel" style="width:228px;object-fit:cover;">
    </a>
    {% else %}
    <div class="key-image">
      <img src="{{ schluessel_image }}" alt="Inszenierungsschlüssel" style="width:228px;object-fit:cover;">
    </div>
    {% endif %}
  </div>
  {% endif %}
  {% if auszug_text %}
  <div class="item">
    <div class="note">Gerne sende ich Ihnen das vollständige Skript unverbindlich zur Lektüre. Schreiben Sie mir einfach eine Nachricht an: mail@daphnesander.com</div>
  </div>
  {% endif %}
  {% if pricing and pricing.length %}
  <div class="item">
    <div class="note">Preise und Lizenzstufen siehe unten ↓</div>
  </div>
  {% endif %}
</div>

{% if auszug_text %}
<template id="lightbox-auszug">
  <p style="font-family:monospace; white-space:pre-wrap; line-height:1.6;">{{ auszug_text }}</p>
</template>
{% endif %}
{% if einblicke and einblicke.length %}
<div class="carousel-section">
  <div class="section-heading">Einblicke</div>
  <div class="carousel" data-gallery-images='{{ einblicke | galleryImages | dump | escape }}'>
    {% for pic in einblicke %}
      <div class="card"><img src="{{ pic.image.src or pic.image }}" style="object-position: {{ pic.image.x if pic.image.x is defined else 50 }}% {{ pic.image.y if pic.image.y is defined else 50 }}%;" alt=""></div>
    {% endfor %}
  </div>
  {% if einblicke.length > 1 %}
  <div class="carousel-dots"></div>
  {% endif %}
</div>
{% endif %}

{% if pricing and pricing.length %}
<div class="pricing-block">
  <div class="section-heading">Preise &amp; Lizenzstufen</div>
  {% for row in pricing %}
    <div class="pricing-row"><span>{{ pricingText(row.label) }}</span><span class="pricing-description">{{ pricingText(row.description) }}</span><span>{{ pricingText(row.price) }}</span></div>
  {% endfor %}
  <div class="pricing-note">Wenn Sie Fragen haben oder eine individuelle Vereinbarung treffen wollen, lassen Sie uns gerne per Mail einen Termin ausmachen: mail@daphnesander.com</div>
</div>
{% endif %}
