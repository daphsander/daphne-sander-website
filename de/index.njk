---
intro_text: Daphne Sander schreibt narrative Film- und Theaterskripte. Sie lebt in Tübingen und Wien.
portrait_image: /images/uploads/WhatsApp Image 2026-09-16 at 14.57.33 (2).jpeg
show_aktuelles: true
currentSection: ''
lang: de
layout: base.njk
pageTitle: Daphne Sander — Film- und Theaterautorin
permalink: /index.html
---

<div class="hero-portrait-row">
  {% if portrait_image %}
    <img class="portrait" src="{{ portrait_image }}" alt="Porträt">
  {% else %}
    <div class="ph portrait">Porträt</div>
  {% endif %}
  <div class="intro-text">{{ intro_text }}</div>
</div>

{% if show_aktuelles %}
<div class="carousel-section">
  <div class="section-heading slim">Aktuelles</div>
  <div class="carousel">
    {% for item in collections.aktuelles %}
    <div class="card">
      {% if item.data.image %}
        <img src="{{ item.data.image }}" alt="" style="height:90px;width:100%;object-fit:cover;">
      {% else %}
        <div class="ph" style="height:90px;">Bild</div>
      {% endif %}
      <div class="kicker">{{ item.data.kicker }}</div>
      <div class="headline">{{ item.data.headline }}</div>
      <div class="summary">{{ item.templateContent | safe }}</div>
    </div>
    {% endfor %}
  </div>
  {% if collections.aktuelles.length > 1 %}
  <div class="carousel-dots">
    {% for item in collections.aktuelles %}<div class="dot{% if loop.first %} active{% endif %}"></div>{% endfor %}
    {% for item in collections.aktuelles %}Hallo, Daphne!{% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}
