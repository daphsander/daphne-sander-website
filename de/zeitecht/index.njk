<div class="page-title-block">
  <h1>ZEITECHT</h1>
  <div class="tagline">Neufassungen klassischer Stoffe fürs Jugendtheater</div>
  {% if secondary_tagline %}<div class="secondary-tagline">{{ secondary_tagline }}</div>{% endif %}
</div>

<div class="foldouts">
  <button class="foldout-toggle" data-target="panel-projekt"><span class="sign">+</span> Über das Projekt</button>
  <button class="foldout-toggle" data-target="panel-begleitmaterial"><span class="sign">+</span> Über das Begleitmaterial</button>
</div>
<div class="foldout-panel" id="panel-projekt">{{ projekt_text | markdownify | safe }}</div>
<div class="foldout-panel" id="panel-begleitmaterial">
  <section class="begleitmaterial-intro">
    <h2>{{ begleitmaterial_intro_title }}</h2>
    <div class="begleitmaterial-intro__columns">
      <article class="begleitmaterial-intro__column">
        <h3>
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="7.5" cy="8" r="4.5"></circle><path d="m11 11.5 9.5 9.5 2-2-2-2 2-2-3-3-2 2-3.5-3.5"></path></svg>
          {{ inszenierungsschluessel_title }}
        </h3>
        <p>{{ inszenierungsschluessel_intro }}</p>
        <div class="begleitmaterial-intro__resource">
          {% if inszenierungsschluessel_eurasia_url %}
          <a href="{{ inszenierungsschluessel_eurasia_url }}">{{ inszenierungsschluessel_eurasia_label }}</a>
          {% else %}
          <span>{{ inszenierungsschluessel_eurasia_label }}</span>
          {% endif %}
        </div>
        <div class="begleitmaterial-intro__footer">
          <div class="begleitmaterial-intro__note">{{ inszenierungsschluessel_note }}</div>
        </div>
      </article>
      <article class="begleitmaterial-intro__column">
        <h3>
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="7.5" cy="8" r="4.5"></circle><path d="m11 11.5 9.5 9.5 2-2-2-2 2-2-3-3-2 2-3.5-3.5"></path></svg>
          {{ kontextschluessel_title }}
        </h3>
        <p>{{ kontextschluessel_intro }}</p>
        <div class="begleitmaterial-intro__footer">
          <div class="begleitmaterial-intro__note">{{ kontextschluessel_note }}</div>
        </div>
      </article>
      <article class="begleitmaterial-intro__column">
        <h3>
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="7.5" cy="8" r="4.5"></circle><path d="m11 11.5 9.5 9.5 2-2-2-2 2-2-3-3-2 2-3.5-3.5"></path></svg>
          {{ dramatikschluessel_title }}
        </h3>
        <p>{{ dramatikschluessel_intro }}</p>
        <div class="begleitmaterial-intro__footer">
          <div class="begleitmaterial-intro__note">{{ dramatikschluessel_note }}</div>
          <div class="begleitmaterial-intro__pricing">
            {% if dramatikschluessel_pricing_url %}
            <a href="{{ dramatikschluessel_pricing_url }}">{{ dramatikschluessel_pricing_label }}</a>
            {% else %}
            {{ dramatikschluessel_pricing_label }}
            {% endif %}
          </div>
        </div>
      </article>
    </div>
  </section>
  {{ begleitmaterial_text | markdownify | safe }}
</div>

<div class="entry-list zeitecht-entry-list">
  {% for item in collections.zeitecht %}
  <div class="entry">
    {% if item.data.is_detailed %}<a class="entry-image-link thumb" href="{{ item.url }}" aria-label="{{ item.data.title }}">{% endif %}
    {% if item.data.desktop_image or item.data.mobile_image %}
      <picture class="{% if item.data.is_detailed %}entry-picture{% else %}thumb{% endif %}">
        {% if item.data.mobile_image %}
          <source media="(max-width: 640px)" srcset="{{ item.data.mobile_image }}">
        {% endif %}
        <img src="{{ item.data.desktop_image or item.data.mobile_image }}" alt="{{ item.data.title }}" style="width:100%;height:100%;object-fit:cover;">
      </picture>
    {% else %}
      <div class="ph thumb">Bild</div>
    {% endif %}
    {% if item.data.is_detailed %}</a>{% endif %}
    <div>
      <div class="title">
        {% if item.data.is_detailed %}<a class="title-link" href="{{ item.url }}">{{ item.data.title }}</a>
        {% else %}{{ item.data.title }}{% endif %}
      </div>
      {% if item.data.overview_meta %}<div class="meta">{{ item.data.overview_meta }}</div>{% endif %}
      {% if item.data.is_detailed %}<a class="link" href="{{ item.url }}">Auszüge, Bilder und Lizenzstufen →</a>{% endif %}
      <div class="desc">{{ item.templateContent | safe }}</div>
      {% if item.data.overview_detail_text %}
        <p class="entry-detail">{{ item.data.overview_detail_text }}</p>
      {% endif %}
    </div>
  </div>
  {% endfor %}
</div>
