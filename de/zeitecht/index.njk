---
layout: base.njk
permalink: /zeitecht/index.html
navKey: "/zeitecht/"
lang: de
pageTitle: "ZEITECHT — Neufassungen klassischer Stoffe fürs Jugendtheater"
currentSection: "/zeitecht/"
projekt_text: |
  [Platzhalter — hier folgt der ausführlichere Text über das Projekt.]
begleitmaterial_text: |
  [Platzhalter — hier folgt der Text über das Begleitmaterial, z.B. Autorenbesuch und Gesprächsformat.]
---
<div class="page-title-block">
  <h1>ZEITECHT</h1>
  <div class="tagline">Neufassungen klassischer Stoffe fürs Jugendtheater</div>
</div>

<div class="foldouts">
  <button class="foldout-toggle" data-target="panel-projekt"><span class="sign">+</span> Über das Projekt</button>
  <button class="foldout-toggle" data-target="panel-begleitmaterial"><span class="sign">+</span> Über das Begleitmaterial</button>
</div>
<div class="foldout-panel" id="panel-projekt">{{ projekt_text | markdownify | safe }}</div>
<div class="foldout-panel" id="panel-begleitmaterial">{{ begleitmaterial_text | markdownify | safe }}</div>

<div class="entry-list">
  {% for item in collections.zeitecht %}
  <div class="entry">
    {% if item.data.image %}
      <img class="thumb" src="{{ item.data.image }}" alt="{{ item.data.title }}">
    {% else %}
      <div class="ph thumb">Bild</div>
    {% endif %}
    <div>
      <div class="title">{{ item.data.title }}</div>
      <div class="desc">{{ item.templateContent | safe }}</div>
      {% if item.data.meta %}<div class="meta">{{ item.data.meta }}</div>{% endif %}
      {% if item.data.is_detailed %}<a class="link" href="{{ item.url }}">Mehr erfahren →</a>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
