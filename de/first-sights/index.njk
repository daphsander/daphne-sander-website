<section class="first-sights-hero wrap">
  <div class="first-sights-media">
    <div class="first-sights-carousel-wrap">
      <div class="first-sights-carousel" data-first-sights-carousel aria-label="First Sights images and videos">
        {% for item in intro_carousel %}
          <div class="first-sights-carousel-slide">
            {% if item.type == "video" and item.video %}
              <video muted loop playsinline preload="metadata" aria-label="{{ item.alt or 'First Sights video' }}">
                <source src="{{ item.video }}">
              </video>
            {% elif item.image %}
              <img src="{{ item.image }}" alt="{{ item.alt or 'First Sights artwork' }}">
            {% else %}
              <div class="first-sights-media-placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="first-sights-carousel-dots" aria-label="Choose an image or video"></div>
  </div>

  <div class="first-sights-hero-copy">
    <div class="first-sights-kicker">{{ intro_kicker }}</div>
    <h1>{{ intro_title }}</h1>
    <div class="first-sights-tagline">{{ intro_tagline }}</div>
    <p>{{ intro_text }}</p>
    <button class="first-sights-button" type="button" data-lightbox="first-sights-contact">
      Invite us to your Event
    </button>
  </div>
</section>

<section class="first-sights-gallery-section wrap" id="first-sights-gallery">
  <h2 class="first-sights-section-heading">Selected work</h2>
  <div class="first-sights-gallery" data-gallery-images='{{ gallery_images | galleryImages | dump | escape }}'>
    {% for item in gallery_images %}
      <button class="first-sights-gallery-item{% if item.orientation == 'landscape' %} is-landscape{% endif %}"
        type="button" aria-label="Open {{ item.caption or 'First Sights artwork' }}">
        {% if item.image %}
          <img src="{{ item.image }}" alt="{{ item.caption or 'First Sights artwork' }}">
        {% else %}
          <div class="first-sights-media-placeholder" aria-hidden="true"></div>
        {% endif %}
        {% if item.caption %}<span class="first-sights-gallery-caption">{{ item.caption }}</span>{% endif %}
      </button>
    {% endfor %}
  </div>
</section>

<section class="first-sights-artists wrap">
  <article>
    <h2>{{ artist_left_name }}</h2>
    <div class="artist-bio">{{ artist_left_text | markdownify | safe }}</div>
  </article>
  <article>
    <h2>{{ artist_right_name }}</h2>
    <div class="artist-bio">{{ artist_right_text | markdownify | safe }}</div>
  </article>
  <button class="first-sights-button first-sights-contact-button" type="button" data-lightbox="first-sights-contact">
    Contact &amp; Acquisition
  </button>
</section>

<template id="first-sights-contact">
  <div class="first-sights-contact-content">
    <h2 id="first-sights-contact-title">Contact &amp; Acquisition</h2>
    {{ contact_text | markdownify | safe }}
  </div>
</template>
