<section class="first-sights-title wrap">
  <h1>FIRST SIGHTS</h1>
  <div class="tagline">Live Sketching Duo</div>
</section>

<section class="first-sights-intro" data-first-sights-intro data-mode="">
  <div class="first-sights-grid">
    <div class="first-sights-slot first-sights-slot-left">
      <div class="first-sights-image-pair" data-intro-image-pair>
        <div class="first-sights-image-track">
          {% if intro_image_left %}
            <img class="first-sights-image" src="{{ intro_image_left }}" alt="FIRST SIGHTS artwork">
          {% else %}
            <div class="ph first-sights-image">Bild links</div>
          {% endif %}
          {% if intro_image_left_active %}
            <img class="first-sights-image" src="{{ intro_image_left_active }}" alt="FIRST SIGHTS artwork">
          {% else %}
            <div class="ph first-sights-image">Bild links</div>
          {% endif %}
        </div>
      </div>
      <button class="first-sights-link" type="button" data-first-sights-mode="project" aria-expanded="false">Über das Projekt</button>
    </div>
    <div class="first-sights-slot first-sights-slot-center">
      <div class="first-sights-image-pair" data-intro-image-pair>
        <div class="first-sights-image-track">
          {% if intro_image_center %}
            <img class="first-sights-image" src="{{ intro_image_center }}" alt="FIRST SIGHTS artwork">
          {% else %}
            <div class="ph first-sights-image">Bild Mitte</div>
          {% endif %}
          {% if intro_image_center_active %}
            <img class="first-sights-image" src="{{ intro_image_center_active }}" alt="FIRST SIGHTS artwork">
          {% else %}
            <div class="ph first-sights-image">Bild Mitte</div>
          {% endif %}
        </div>
      </div>
      <button class="first-sights-link" type="button" data-first-sights-mode="artists" aria-expanded="false">Über die Künstler</button>
    </div>
    <div class="first-sights-slot first-sights-slot-right">
      {% if intro_image_right %}
        <img class="first-sights-image" src="{{ intro_image_right }}" alt="FIRST SIGHTS artwork">
      {% else %}
        <div class="ph first-sights-image">Bild rechts</div>
      {% endif %}
      <a class="first-sights-link" href="#first-sights-gallery">Galerie ↓</a>
    </div>

    <div class="first-sights-copy first-sights-project-copy">
      {{ project_text | markdownify | safe }}
    </div>
    <div class="first-sights-copy first-sights-artist-copy first-sights-artist-left">
      {{ artist_left_text | markdownify | safe }}
    </div>
    <div class="first-sights-copy first-sights-artist-copy first-sights-artist-right">
      {{ artist_right_text | markdownify | safe }}
    </div>
  </div>
</section>

<section class="carousel-section first-sights-news">
  <div class="section-heading slim">News</div>
  <div class="carousel">
    {% for item in collections.first_sights_aktuelles | sortByOrderDescending %}
    <div class="card">
      {% if item.data.image %}
        <img src="{{ item.data.image.src or item.data.image }}" alt="" style="width:100%;object-fit:cover;aspect-ratio:4/3;">
      {% else %}
        <div class="ph" style="height:90px;">Bild</div>
      {% endif %}
      <div class="kicker">{{ item.data.kicker }}</div>
      <div class="headline">{{ item.data.headline }}</div>
      <div class="summary">{{ item.templateContent | safe }}</div>
    </div>
    {% endfor %}
  </div>
  {% if collections.first_sights_aktuelles.length > 1 %}
  <div class="carousel-dots"></div>
  {% endif %}
</section>

<section class="first-sights-gallery-section" id="first-sights-gallery">
  <div class="section-heading">Galerie</div>
  <div class="first-sights-gallery" data-gallery-images='{{ gallery_images | galleryImages | dump | escape }}'>
    {% for item in gallery_images %}
      <button class="first-sights-gallery-item{% if item.orientation == 'landscape' %} is-landscape{% endif %}" type="button" aria-label="Galeriebild öffnen">
        {% if item.image %}
          <img src="{{ item.image.src or item.image }}" alt="{{ item.caption or '' }}">
        {% else %}
          <div class="ph">Bild</div>
        {% endif %}
      </button>
    {% endfor %}
  </div>
</section>
